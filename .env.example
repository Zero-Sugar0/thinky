# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Use the same value for the web and eve services.
INTERNAL_API_SECRET=replace-with-a-random-secret

# Required PostgreSQL connection URL. Use a provisioned database, such as Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional canonical URL for SEO.
NUXT_PUBLIC_SITE_URL=

# Upstash QStash (for hourly proactive check cron)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=
# Composio API Key (https://dashboard.composio.dev -> Platform)
COMPOSIO_API_KEY=

# Camofox browser service (configure on the Eve service)
CAMOFOX_BASE_URL=https://camofox-browser-production-a211.up.railway.app
CAMOFOX_ACCESS_KEY=

# Telegram bot credentials (configure on the eve service)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
