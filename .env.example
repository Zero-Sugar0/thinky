# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Use the same value for the web and eve services.
INTERNAL_API_SECRET=replace-with-a-random-secret

# Required PostgreSQL connection URL. Use a provisioned database, such as Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional canonical URL for SEO.
NUXT_PUBLIC_SITE_URL=

# Composio API Key (https://dashboard.composio.dev -> Platform)
COMPOSIO_API_KEY=